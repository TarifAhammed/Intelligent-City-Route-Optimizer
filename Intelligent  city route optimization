
import heapq


class CityRouteOptimizer:
    def __init__(self):
        # Each location stores its connected roads
        self.graph = {}
        self.closed_roads = set()

    def add_location(self, name):
        self.graph.setdefault(name, {})

    def add_road(self, a, b, distance, time, cost):
        if min(distance, time, cost) < 0:
            raise ValueError("Values cannot be negative.")

        self.add_location(a)
        self.add_location(b)

        details = {
            "distance": distance,
            "time": time,
            "cost": cost
        }

        # Roads work in both directions
        self.graph[a][b] = details
        self.graph[b][a] = details

    def close_road(self, a, b):
        self.closed_roads.add(frozenset([a, b]))

    def open_road(self, a, b):
        self.closed_roads.discard(frozenset([a, b]))

    def shortest_route(self, start, destination, metric="time"):
        if metric not in ("time", "distance", "cost"):
            raise ValueError("Choose time, distance, or cost.")

        if start not in self.graph or destination not in self.graph:
            return None

        distances = {node: float("inf") for node in self.graph}
        previous = {}

        distances[start] = 0
        priority_queue = [(0, start)]

        while priority_queue:
            current_distance, current = heapq.heappop(
                priority_queue
            )

            # Ignore outdated queue entries
            if current_distance != distances[current]:
                continue

            if current == destination:
                break

            for neighbor, road in self.graph[current].items():

                # Skip closed roads
                if frozenset([current, neighbor]) in self.closed_roads:
                    continue

                new_distance = (
                    current_distance + road[metric]
                )

                if new_distance < distances[neighbor]:
                    distances[neighbor] = new_distance
                    previous[neighbor] = current

                    heapq.heappush(
                        priority_queue,
                        (new_distance, neighbor)
                    )

        if distances[destination] == float("inf"):
            return None

        # Reconstruct the optimal path
        path = []
        current = destination

        while current != start:
            path.append(current)
            current = previous[current]

        path.append(start)
        path.reverse()

        # Calculate all metrics for the selected path
        totals = {
            "distance": 0,
            "time": 0,
            "cost": 0
        }

        for a, b in zip(path, path[1:]):
            road = self.graph[a][b]

            for key in totals:
                totals[key] += road[key]

        return {
            "path": path,
            "totals": totals,
            "optimized_for": metric
        }


def main():
    city = CityRouteOptimizer()

    roads = [
        ("Dhaka", "Gazipur", 25, 45, 100),
        ("Dhaka", "Narayanganj", 20, 40, 80),
        ("Gazipur", "Mymensingh", 95, 120, 300),
        ("Gazipur", "Tangail", 55, 70, 180),
        ("Tangail", "Mymensingh", 65, 85, 200),
        ("Narayanganj", "Cumilla", 95, 110, 250),
        ("Cumilla", "Sylhet", 180, 240, 550),
        ("Mymensingh", "Sylhet", 180, 210, 500),
        ("Tangail", "Rajshahi", 190, 220, 600),
        ("Rajshahi", "Sylhet", 300, 360, 800),
        ("Cumilla", "Chattogram", 150, 180, 450)
    ]

    for road in roads:
        city.add_road(*road)

    print("=== INTELLIGENT CITY ROUTE OPTIMIZER ===")

    locations = sorted(city.graph)
    print("\nAvailable locations:")
    print(", ".join(locations))

    start = input("\nStarting location: ").strip().title()
    destination = input("Destination: ").strip().title()

    print("\nOptimize route by:")
    print("1. Minimum travel time")
    print("2. Minimum distance")
    print("3. Minimum cost")

    choice = input("Enter choice (1-3): ").strip()

    metrics = {
        "1": "time",
        "2": "distance",
        "3": "cost"
    }

    if choice not in metrics:
        print("Invalid choice.")
        return

    # Optional road closure
    close = input(
        "\nClose a road before searching? (y/n): "
    ).strip().lower()

    if close == "y":
        a = input("First location on road: ").strip().title()
        b = input("Second location on road: ").strip().title()

        if (
            a in city.graph
            and b in city.graph
            and b in city.graph[a]
        ):
            city.close_road(a, b)
            print(f"Road {a} <-> {b} closed.")
        else:
            print("Road not found. No road was closed.")

    result = city.shortest_route(
        start,
        destination,
        metrics[choice]
    )

    if result is None:
        print("\nNo available route found.")
        return

    print("\n=== OPTIMAL ROUTE ===")
    print(" -> ".join(result["path"]))

    print("\n=== ROUTE SUMMARY ===")
    print(f"Distance: {result['totals']['distance']} km")
    print(f"Travel time: {result['totals']['time']} minutes")
    print(f"Estimated cost: {result['totals']['cost']} units")
    print(f"Optimized for: {result['optimized_for'].title()}")


if __name__ == "__main__":
    main()
